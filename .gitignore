# ============================================================
# 环境安装项目 .gitignore
# ============================================================

# ---- 备份文件 ----
*.bak
*.bak.*
*.backup
*.old
*.orig
backups/

# ---- 临时与测试文件 ----
*.tmp
*.temp
.permission_test_*

# ---- 编辑器与系统 ----
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.zcode/

# ---- 日志 ----
*.log

# ---- 敏感信息（按需添加，例如导出的配置中含密码/密钥）----
*.key
*.pem
*.ovpn
auth.txt
secrets/
.env
.env.local

# ---- 挂载点占位（防止误提交空挂载目录）----
mnt/
